          "name": "stock_movements_direction_valid",
          "value": "(\"stock_movements\".\"type\" = 'OUT' and \"stock_movements\".\"quantity_change\" < 0)\n        or (\"stock_movements\".\"type\" in ('IN', 'OPENING') and \"stock_movements\".\"quantity_change\" > 0)\n        or (\"stock_movements\".\"type\" = 'ADJUSTMENT' and \"stock_movements\".\"quantity_change\" <> 0)"
        },
