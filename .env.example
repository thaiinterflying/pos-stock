# ---------------------------------------------------------------------------
# TIF Stock — Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วแทนค่าจริง (ห้าม commit .env.local)
# ---------------------------------------------------------------------------

# Neon PostgreSQL — pooled endpoint ใช้ตอนรันแอป (ต้องมี "-pooler" ใน host)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/tifstock?sslmode=require"

# Neon PostgreSQL — direct endpoint ใช้กับ drizzle-kit migrate (ไม่บังคับ)
# ถ้าไม่กำหนด จะใช้ DATABASE_URL แทน
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/tifstock?sslmode=require"

# Pepper สำหรับ hash อีเมลในตาราง login_attempts (สร้างด้วย: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# ใช้เฉพาะตอนรัน `bun run db:seed`
# ถ้าไม่กำหนดรหัสผ่าน สคริปต์จะสุ่มให้และพิมพ์ออกทางหน้าจอ
SEED_ADMIN_NAME="ผู้ดูแลระบบ"
SEED_ADMIN_EMAIL="admin@tif.local"
SEED_ADMIN_PASSWORD="adminIT@25658!."

# Neon Object Storage (สร้างโดย neon deploy / neon.ts)
# bucket ที่ declare ไว้ใน neon.ts คือ "assets" — กำหนดทับได้ถ้าเปลี่ยนชื่อ
# STORAGE_BUCKET="assets"

# ใช้เฉพาะ integration tests (แนะนำ Neon branch แยก ไม่ใช้ branch production)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/tifstock_test?sslmode=require"

SEED_STAFF_NAME="พนักงานตัวอย่าง"
SEED_STAFF_EMAIL="staff@tif.local"
SEED_STAFF_PASSWORD=""
